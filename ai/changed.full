	VMDPhysicalStatusPartiallyOperational VMDPhysicalStatus = 1
	VMDPhysicalStatusInoperable           VMDPhysicalStatus = 2
	VMDPhysicalStatusNeedsCommissioning   VMDPhysicalStatus = 3
