		DomainID:    "testDomain",
	})
	if err != nil {
		t.Fatalf("GetNameList NVL: %v", err)
	}
	if len(nl.Names) != 2 {
		t.Fatalf("Names = %v, want 2 entries", nl.Names)
	}
	if nl.Names[0] != "list1" || nl.Names[1] != "list2" {
		t.Errorf("Names = %v, want [list1 list2]", nl.Names)
	}
}

