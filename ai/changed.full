		t.Fatalf("unmarshal outer: %v", err)
	}

	invokeID, serviceRaw, err := codec.UnmarshalConfirmedRequest(raw.Bytes)
	if err != nil {
		t.Fatalf("unmarshal confirmed request: %v", err)
	}
