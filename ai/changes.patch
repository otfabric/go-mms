// String returns the human-readable name of the ObjectClass.
func (c ObjectClass) String() string {
	if int(c) >= 0 && int(c) < len(objectClassNames) {
		return objectClassNames[c]
	}
	return fmt.Sprintf("ObjectClass(%d)", int(c))
