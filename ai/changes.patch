func TestUnmarshalInner(t *testing.T) {
	type inner struct {
		Value int
	}
	val := inner{Value: 42}
	encoded, _ := asn1.Marshal(val)
	raw := asn1.RawValue{Class: 2, Tag: 0, IsCompound: true, Bytes: encoded}

	var result inner
	err := UnmarshalInner(raw, &result)
