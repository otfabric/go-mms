	// visible string
	f.Add(berutil.EncodeTLV(0x8a, []byte("hello")))
	// octet string
	f.Add(berutil.EncodeTLV(0x89, []byte{0xde, 0xad}))
	// bit string: unused=2, data=0xfc
	f.Add(berutil.EncodeTLV(0x84, []byte{2, 0xfc}))
	// empty
