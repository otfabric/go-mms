----+
----+func appendLength(buf []byte, l int) []byte {
---- 	if l < 128 {
-----		buf = make([]byte, 0, 2+l)
-----		buf = append(buf, tag, byte(l))
-----	} else if l < 256 {
-----		buf = make([]byte, 0, 3+l)
-----		buf = append(buf, tag, 0x81, byte(l))
-----	} else if l < 65536 {
