----// --- FileName encoding helpers ---
----
----// MMS FileName is a SEQUENCE OF GraphicString. In practice, a single
----// element containing the file path. Encoded as a SEQUENCE containing
----// one IA5String (tag 0x19).
----
----func encodeFileName(name string) []byte {
----	inner := encodeFileNameInner(name)
----	return berutil.EncodeTLV(0xa0, inner)
----}
----
----func encodeFileNameTag(tag byte, name string) []byte {
----	inner := encodeFileNameInner(name)
----	return berutil.EncodeTLV(tag, inner)
----}
----
----func encodeFileNameInner(name string) []byte {
----	return berutil.EncodeTLV(0x19, []byte(name))
----}
----
----// decodeFileName decodes a FileName from BER data. FileName is
----// SEQUENCE OF GraphicString (tag 0x19). The data may be either:
----//   - The raw SEQUENCE content (one or more 0x19 TLVs)
----//   - A single GraphicString (0x19 TLV)
----//   - Wrapped in a context tag ([0] or similar)
----//
----// In all cases, we extract the first GraphicString value.
----func decodeFileName(data []byte) string {
----	if len(data) == 0 {
----		return ""
----	}
----	tag, inner, _, err := berutil.DecodeTLVAt(data, 0)
----	if err != nil {
----		return string(data)
----	}
----
----	if tag == 0x19 {
----		return string(inner)
----	}
----
----	// Constructed wrapper â€” recurse into content
----	return decodeFileName(inner)
----}
