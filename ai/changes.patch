----func parseFileAttributes(data []byte, r *FileOpenResult) error {
----	offset := 0
----	for offset < len(data) {
----		tag, inner, n, err := berutil.DecodeTLVAt(data, offset)
----		if err != nil {
----			return fmt.Errorf("pdu: file attributes: %w", err)
----		}
----		offset += n
----		switch tag {
----		case 0x80: // sizeOfFile
----			v, err := berutil.DecodeUnsigned(inner)
----			if err != nil {
----				return fmt.Errorf("pdu: file size: %w", err)
----			}
