----// FileDirectory lists files on the remote MMS server matching the
----// given path specification. Pass an empty fileSpec to list all files.
----func (c *Client) FileDirectory(ctx context.Context, fileSpec string) ([]FileDirectoryEntry, error) {
----	var allEntries []FileDirectoryEntry
----	continueAfter := ""
----
----	for {
----		invokeID := c.nextInvokeID()
----		reqBytes, err := pdu.MarshalFileDirectoryRequest(invokeID, fileSpec, continueAfter)
----		if err != nil {
----			return nil, fmt.Errorf("mms: marshal file-directory request: %w", err)
----		}
----
----		confirmed, err := c.sendConfirmed(ctx, invokeID, reqBytes)
----		if err != nil {
----			return nil, err
----		}
----
----		if confirmed.ServiceKind != pdu.ServiceFileDirectory {
----			return nil, &ProtocolError{
----				Phase:   "mms",
----				Message: fmt.Sprintf("expected FileDirectory response, got %s", confirmed.ServiceKind),
----			}
----		}
----
----		wireEntries, moreFollows, err := pdu.UnmarshalFileDirectoryResponse(confirmed.ServiceData.Bytes)
----		if err != nil {
----			return nil, fmt.Errorf("mms: %w", err)
----		}
----
----		for _, we := range wireEntries {
----			allEntries = append(allEntries, FileDirectoryEntry{
----				Name:         we.FileName,
----				Size:         we.Size,
----				LastModified: we.LastModified,
----			})
----		}
----
----		if !moreFollows || len(wireEntries) == 0 {
----			break
----		}
----		continueAfter = wireEntries[len(wireEntries)-1].FileName
----	}
----
----	return allEntries, nil
----}
