	matched := berutil.EncodeTLV(0x02, []byte{0x01}) // 1
	deleted := berutil.EncodeTLV(0x02, []byte{0x01}) // 1

	content := append(matched, deleted...)
	serviceData := asn1.RawValue{
		Class:      asn1.ClassContextSpecific,
