----+func encodeTagNumber(n int) []byte {
----+	if n < 0x80 {
----+		return []byte{byte(n)}
----+	}
----+	if n < 0x4000 {
----+		return []byte{byte(n>>7) | 0x80, byte(n & 0x7f)}
----+	}
----+	return []byte{byte(n>>14) | 0x80, byte(n>>7) | 0x80, byte(n & 0x7f)}
