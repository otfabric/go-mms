	if err != nil {
		t.Fatalf("tls identify: %v", err)
	}

	if plainID.Vendor != tlsID.Vendor {
		t.Errorf("vendor mismatch: plain=%q tls=%q", plainID.Vendor, tlsID.Vendor)
	}
