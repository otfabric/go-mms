		{"128", 128, []byte{0x00, 0x80}},
		{"255", 255, []byte{0x00, 0xff}},
		{"256", 256, []byte{0x01, 0x00}},
		{"32767", 32767, []byte{0x7f, 0xff}},
		{"32768", 32768, []byte{0x00, 0x80, 0x00}},
		{"65535", 65535, []byte{0x00, 0xff, 0xff}},
