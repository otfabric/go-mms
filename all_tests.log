func BenchmarkUnmarshalDataElementBoolean(b *testing.B) {
	data := berutil.EncodeTLV(0x83, []byte{0xff})
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		_, _, _ = UnmarshalDataElement(data, 0)
