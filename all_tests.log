	}
}

// TestInteropGetNameListRequestEncoding verifies GetNameList request
// encoding for VMD scope.
func TestInteropGetNameListRequestEncoding(t *testing.T) {
	pdu, err := MarshalGetNameListRequest(1, 0, ScopeVMD, "", "")
	if err != nil {
