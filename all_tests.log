		{[]byte{0x03}, 3},
		{[]byte{0x7f}, 127},
	}
	for _, tt := range tests {
		got, err := DecodeInteger(tt.data)
		if err != nil {
			t.Errorf("DecodeInteger(%x): %v", tt.data, err)
			continue
		}
		if got != tt.want {
