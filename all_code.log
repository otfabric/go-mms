	spec := VariableSpecWire{Name: name}

	if consumed < len(data) {
		tag, content, n, err := berutil.DecodeTLVAt(data, consumed)
		if err != nil {
			return VariableSpecWire{}, fmt.Errorf("alternate access: %w", err)
