	for _, r := range results {
		if r.IsError {
			inner = append(inner, berutil.EncodeTLV(TagDataAccessError, encodeSmallInt(r.ErrorCode))...)
		} else {
			encoded, err := MarshalData(r.Data)
			if err != nil {
