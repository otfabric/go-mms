	if offset != len(data) {
		return nil, fmt.Errorf("getnamelist request: %d trailing bytes", len(data)-offset)
	}

	return &GetNameListRequest{
		ObjectClass:   objectClass,
		Scope:         scope,
		DomainID:      domainID,
		ContinueAfter: continueAfter,
